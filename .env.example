# Copy this file to .env and fill in the two values from the Foundry portal.
# The code signs in as you with `az login`: no keys go here.
# Either address works: the project endpoint (.../api/projects/<project>) or the model endpoint
# from the portal's sample code (https://<resource>.services.ai.azure.com/openai/v1).
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
FOUNDRY_MODEL=gpt-5-mini
# Optional: how much a gpt-5 model thinks before it answers (low, medium, high), or none for a
# model without reasoning (for example gpt-4.1-mini). Default: low.
# FOUNDRY_REASONING_EFFORT=low
